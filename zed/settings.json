{
  "git_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
  },
  "debugger": {
    "dock": "left",
  },
  "proxy": "",
  "edit_predictions": {
    "provider": "copilot",
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "agent": {
    "sidebar_side": "right",
    "button": false,
    "dock": "right",
    "default_profile": "write",

    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "claude-4-5-haiku",
    },
  },
  "icon_theme": "Material Icon Theme",
  "vim_mode": true,
  "base_keymap": "VSCode",
  "theme": "Everforest Dark Hard (blur)",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 13,
  "ui_font_size": 13,
  "buffer_line_height": { "custom": 1.7 },
  "relative_line_numbers": "enabled",
  "cursor_shape": "block",
  "cursor_blink": false,
  "current_line_highlight": "gutter",
  "scrollbar": { "show": "never" },
  "gutter": { "folds": false, "runnables": false, "min_line_number_digits": 0 },
  "indent_guides": { "enabled": true },
  "project_panel": {
    "dock": "left",
    "hide_root": true,
    "git_status": false,
    "sticky_scroll": false,
    "auto_fold_dirs": false,
    "scrollbar": { "show": "never" },
    "indent_guides": { "show": "never" },
  },
  "outline_panel": { "button": false, "indent_guides": { "show": "never" } },
  "toolbar": { "quick_actions": false },
  "tab_bar": { "show": true },
  "title_bar": {
    "show_branch_name": true,
    "show_project_items": true,
    "show_user_menu": true,
    "show_onboarding_banner": true,
  },
  "status_bar": { "experimental.show": true },
  "show_whitespaces": "none",
  "tab_size": 2,
  "auto_indent": "syntax_aware",
  "selection_highlight": false,
  "hover_popover_enabled": true,
  "inlay_hints": { "enabled": true },
  "format_on_save": "on",
  "autosave": { "after_delay": { "milliseconds": 1000 } },
  "prettier": { "allowed": true },
  "terminal": {
    "working_directory": "current_project_directory",
    "dock": "right",
    "default_width": 380,
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 13,
    "line_height": { "custom": 1.7 },
  },
  "experimental.theme_overrides": {
    "background.appearance": "transparent",

    "background": "#141b1ef5",

    "editor.background": "#141b1ee8",

    "panel.background": "#141b1ee8",

    "surface.background": "#141b1ee8",

    "terminal.background": "#141b1ee8",

    "tab_bar.background": "#141b1ef0",

    "title_bar.background": "#141b1ef0",

    "status_bar.background": "#141b1ef0",
  },
  "languages": {
    "Go": { "formatter": { "external": { "command": "gofumpt" } } },
    "Python": {
      "formatter": {
        "external": { "command": "ruff", "arguments": ["format", "-"] },
      },
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TSX": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "gofumpt": true,
        "staticcheck": true,
        "usePlaceholders": true,
      },
    },
  },
}

